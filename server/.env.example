# ===== JIVA SERVER ENVIRONMENT =====

# Port the backend listens on
PORT=4000

# The URL of the Next.js client (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB connection string (Atlas or local)
# Local example: mongodb://127.0.0.1:27017/jiva
MONGO_URI=mongodb://127.0.0.1:27017/jiva

# JWT secrets - MUST be changed in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Demo / initial admin that gets created by the seeder
SEED_ADMIN_EMAIL=admin@jiva.ai
SEED_ADMIN_PASSWORD=admin123

# Name shown for the platform
APP_NAME=JIVA

# In production set to true
NODE_ENV=development
